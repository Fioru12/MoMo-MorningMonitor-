# MoMo — Morning Monitor Configuration
# Copy this file to .env and customize if needed

# Server - single port for HTTP + WebSocket
# Cambia qui la porta se hai conflitti (es. 3005, 4000, 8080)
PORT=3100
NODE_ENV=production

# PIN richiesto per usare il Web Terminal (esecuzione comandi shell).
# Se non impostato, ne viene generato uno casuale ad ogni avvio e stampato
# in console: usalo per test rapidi, ma imposta un valore fisso qui se
# esponi MoMo sulla rete locale o oltre.
TERMINAL_PIN=
